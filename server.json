{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.Clawdlinux/atticdb",
  "title": "AtticDB",
  "description": "Local, durable memory for coding agents. Facts with revision history, turns, word search.",
  "repository": {
    "url": "https://github.com/Clawdlinux/atticdb",
    "source": "github"
  },
  "websiteUrl": "https://atticdb.com",
  "version": "0.0.0",
  "packages": [
    {
      "registryType": "cargo",
      "identifier": "atticdb",
      "version": "0.0.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
