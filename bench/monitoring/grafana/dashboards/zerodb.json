{
 "uid": "zerodb",
 "title": "zerodb bench",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Committed appends",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(zerodb_append_ack_seconds_count[10s])",
     "legendFormat": "acks/s"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Append ack latency",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, rate(zerodb_append_ack_seconds_bucket[10s]))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, rate(zerodb_append_ack_seconds_bucket[10s]))",
     "legendFormat": "p99"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.999, rate(zerodb_append_ack_seconds_bucket[10s]))",
     "legendFormat": "p99.9"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Requests per sync group",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(zerodb_writer_group_requests_total[10s]) / rate(zerodb_writer_groups_total[10s])",
     "legendFormat": "requests/group"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Busy replies",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(zerodb_busy_replies_total[10s])",
     "legendFormat": "503 busy/s"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Disk writes",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_disk_writes_completed_total{device=~\"nvme.*|sd.*\"}[10s])",
     "legendFormat": "{{device}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Disk write latency",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_disk_write_time_seconds_total{device=~\"nvme.*|sd.*\"}[10s]) / rate(node_disk_writes_completed_total{device=~\"nvme.*|sd.*\"}[10s])",
     "legendFormat": "{{device}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "CPU",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode=~\"user|system|iowait|softirq\"}[10s])) / scalar(count(node_cpu_seconds_total{mode=\"idle\"}))",
     "legendFormat": "{{mode}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Context switches",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(node_context_switches_total[10s])",
     "legendFormat": "switches/s"
    }
   ]
  }
 ]
}