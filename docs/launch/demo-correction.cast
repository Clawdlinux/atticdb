{"version": 2, "width": 84, "height": 26, "timestamp": 1795504280, "title": "AtticDB: 2 agents share 1 store, stale write refused", "env": {"SHELL": "/bin/zsh", "TERM": "xterm-256color"}}
[0.15, "o", "$ python3 scripts/demo_correction.py\r\n"]
[0.476, "o", "AtticDB demo: a correction reaches another agent\r\n"]
[0.476, "o", "2 agents share 1 store. Key: repo/shop/package-manager\r\n"]
[0.476, "o", "\r\n"]
