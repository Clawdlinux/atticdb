[3.571, "o", "    \"Use npm.\" (by agent-a, lsn 2)\r\n"]
[5.077, "o", "[A] fact_get, then fact_set the correction\r\n"]
[5.084, "o", "    \"Use pnpm, not npm. npm broke the lockfile on 2026-11-02.\"\r\n"]
[5.084, "o", "    committed lsn=3\r\n"]
[6.591, "o", "[B] fact_set \"Use npm. Faster installs.\" (from its old read)\r\n"]
[6.593, "o", "    Refused. Nothing was written. The server says:\r\n"]
[6.593, "o", "    | conflict: this fact changed, or you haven't read it in this chat yet.\r\n"]
[6.593, "o", "    | Nothing was written. Its current value is below. Merge it with your\r\n"]
[6.593, "o", "    | change and call fact_set again.\r\n"]
[6.593, "o", "    | Use pnpm, not npm. npm broke the lockfile on 2026-11-02.\r\n"]
[6.593, "o", "    | by agent-a at 2026-11-24T07:11:15Z\r\n"]
[8.096, "o", "[B] fact_history, newest first\r\n"]
[8.097, "o", "    lsn 3 by agent-a: Use pnpm, not npm. npm broke the lockfile on 2026-11-02.\r\n"]
[8.097, "o", "    lsn 2 by agent-a: Use npm.\r\n"]
[9.606, "o", "\r\n"]
[9.607, "o", "Current value: \"Use pnpm, not npm. npm broke the lockfile on 2026-11-02.\"\r\n"]
[9.607, "o", "B's stale write never landed.\r\n"]
