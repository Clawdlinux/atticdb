{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "out",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/docs",
      "has": [
        {
          "type": "host",
          "value": "atticdb.com"
        }
      ],
      "destination": "https://docs.atticdb.com/",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "has": [
        {
          "type": "host",
          "value": "atticdb.com"
        }
      ],
      "destination": "https://docs.atticdb.com/:path*",
      "permanent": true
    },
    {
      "source": "/docs",
      "has": [
        {
          "type": "host",
          "value": "www.atticdb.com"
        }
      ],
      "destination": "https://docs.atticdb.com/",
      "permanent": true
    },
    {
      "source": "/docs/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.atticdb.com"
        }
      ],
      "destination": "https://docs.atticdb.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.atticdb.com"
        }
      ],
      "destination": "https://atticdb.com/:path*",
      "permanent": true
    },
    {
      "source": "/pricing",
      "has": [
        {
          "type": "host",
          "value": "docs.atticdb.com"
        }
      ],
      "destination": "https://atticdb.com/pricing",
      "permanent": true
    },
    {
      "source": "/compare",
      "has": [
        {
          "type": "host",
          "value": "docs.atticdb.com"
        }
      ],
      "destination": "https://atticdb.com/compare",
      "permanent": true
    },
    {
      "source": "/benchmarks",
      "has": [
        {
          "type": "host",
          "value": "docs.atticdb.com"
        }
      ],
      "destination": "https://atticdb.com/benchmarks",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "docs.atticdb.com"
        }
      ],
      "destination": "/docs"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "docs.atticdb.com"
        }
      ],
      "destination": "/docs/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "docs.atticdb.com"
        }
      ],
      "destination": "/docs/robots.txt"
    },
    {
      "source": "/:path((?!_next/|images/|fonts/|icon\\.svg|og\\.png|docs/|sitemap\\.xml|robots\\.txt).*)",
      "has": [
        {
          "type": "host",
          "value": "docs.atticdb.com"
        }
      ],
      "destination": "/docs/:path"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
